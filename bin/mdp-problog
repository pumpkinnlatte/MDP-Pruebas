import argparse
import os
import sys
import time

import mdpproblog
from mdpproblog.verbosity import VerbosityConfig, VerbosityLevel, setup_verbosity
from mdpproblog.mdp import MDP
from mdpproblog.value_iteration import ValueIteration
from mdpproblog.reporting.csv_exporter import CSVExporter
from mdpproblog.simulator import Simulator
from mdpproblog.fluent import StateSpace

MODELS = {
    'sysadmin1' : ['sysadmin',       'domain.pl',  'star2.pl'],
    'sysadmin2' : ['sysadmin',       'domain2.pl', 'star2.pl'],
    'vm1'       : ['viralmarketing', 'domain1.pl', 'network1.pl'],
    'vm2'       : ['viralmarketing', 'domain2.pl', 'network1.pl'],
    'vm3'       : ['viralmarketing', 'domain3.pl', 'network2.pl'],
    'vm4'       : ['viralmarketing', 'domain4.pl', 'network2.pl'],
    'mgrid'     : ['mitchell_grid',  'domain01.pl', 'grid_original.pl'],
    'mgrid01'   : ['mitchell_grid',  'domain02.pl', 'grid01.pl'],
    'mgrid02'   : ['mitchell_grid',  'domain02.pl', 'grid02.pl'],
    'mgrid03'   : ['mitchell_grid',  'domain02.pl', 'grid03.pl'],
    'mgrid04'   : ['mitchell_grid',  'domain02.pl', 'grid04.pl'],
    'mgrid05'   : ['mitchell_grid',  'domain02.pl', 'grid05.pl'],
    'mgrid06'   : ['mitchell_grid',  'domain02.pl', 'grid06.pl'],
    'mgrid07'   : ['mitchell_grid',  'domain02.pl', 'grid07.pl'],
    'mgrid08'   : ['mitchell_grid',  'domain02.pl', 'grid08.pl']
}


def parse():
    usage = "mdp-problog {list, show, simulate, solve} [-m DOMAIN INSTANCE] [OPTIONS]"
    description = """
        MDP-ProbLog is a Python3 framework to represent and solve
        Markovian Decision Processes by Probabilistic Logic Programming.

        This project is free software.

        Please check the documentation at http://pythonhosted.org/mdpproblog/.
        """.strip()

    help_commands = """
        available commands: list examples, show and solve models or simulate optimal policy
        """.strip()

    parser = argparse.ArgumentParser(usage=usage, description=description)
    parser.add_argument("command", choices=['list', 'show', 'solve', 'simulate'], help=help_commands)
    parser.add_argument("-m", "--model", nargs=2, help="list of domain and instance files")
    parser.add_argument("-x", "--example", type=str, help="select model from examples")
    parser.add_argument("-g", "--gamma",   type=float, default=0.9, help="discount factor    (default=0.9)")
    parser.add_argument("-e", "--epsilon", type=float, default=0.1, help="maximum error      (default=0.1)")
    parser.add_argument("-t", "--trials",  type=int,   default=100, help="number of trials   (default=100)")
    parser.add_argument("-z", "--horizon", type=int,   default=50,  help="simulation horizon (default=50)")
    parser.add_argument("-b", "--backend", type=str, default=None, help="ProbLog compilation backend preference(default=None)")
    parser.add_argument("-v", "--verbosity", type=str.lower, choices=['0', '1', '2', 'silent', 'schema', 'trace'], default=0, help="Observability level: 0/silent (no logs), 1/schema (summary), 2/trace (step-by-step).")
    parser.add_argument('-o', '--output',type=str,default=None,help="Target directory for CSV results export. Default: 'output'.")
    return parser.parse_args()

def load_model(domain, instance):
    with open(domain, 'r') as domain:
        domain_model = domain.read()
    with open(instance, 'r') as instance:
        instance_model = instance.read()
    return domain_model, instance_model

def resolve_verbosity(val):
    """
    Maps the validated verbosity argument to a VerbosityLevel enum.
    """
    mapping = {
        '0': VerbosityLevel.SILENT,
        'silent': VerbosityLevel.SILENT,
        '1': VerbosityLevel.SCHEMA,
        'schema': VerbosityLevel.SCHEMA,
        '2': VerbosityLevel.TRACE,
        'trace': VerbosityLevel.TRACE
    }
    return mapping[str(val).lower()]

def print_list_examples():
    examples = ', '.join(sorted(MODELS.keys()))
    print('>> Available examples: [{}]'.format(examples))


def show_model(domain, instance):
    domain, instance = load_model(domain, instance)
    print(":: DOMAIN ::")
    print(domain)
    print()
    print(":: INSTANCE ::")
    print(instance)
    print()


def solve_model(mdp, gamma, epsilon, verbosity = None, track_history=False, compute_q=False):
    vi = ValueIteration(mdp)
    return vi.run(gamma, epsilon, track_history=track_history, compute_q=compute_q, verbosity=verbosity)


def print_solution(vi_result, uptime):
    print()
    for state_tuple, value in vi_result.V.items():
        state_str = ', '.join(["{f}={v}".format(f=f, v=v) for f, v in state_tuple])
        print("Value({state}) = {value:.3f}".format(state=state_str, value=value))
    print()
    for state_tuple, action_tuple in vi_result.policy.items():
        state_str = ', '.join(["{f}={v}".format(f=f, v=v) for f, v in state_tuple])
        action_name = next(term for term, val in action_tuple.items() if val == 1)
        print("Policy({state}) = {action}".format(state=state_str, action=action_name))
    print()
    print(">> Value iteration converged in {0:.3f}sec after {1} iterations.".format(uptime, vi_result.iterations))
    print(">> Average time per iteration = {0:.3f}sec.".format(uptime / vi_result.iterations))

if __name__ == '__main__':
    args = parse()

    if args.command == 'list':
        print_list_examples()
        exit(0)

    if args.example:
        model_dir, domain, instance = MODELS[args.example]
        model_dir = os.path.join(os.path.dirname(mdpproblog.__file__), 'models/', model_dir)
        domain    = os.path.join(model_dir, domain)
        instance  = os.path.join(model_dir, instance)
    else:
        domain   = args.model[0]
        instance = args.model[1]

    if args.command == 'show':
        show_model(domain, instance)

    if args.command in ['solve', 'simulate']:
        domain, instance = load_model(domain, instance)
        model = domain + instance

        v_level = resolve_verbosity(args.verbosity)
        verbosity = VerbosityConfig(v_level)
        setup_verbosity(verbosity)
        
        mdp = MDP(model, backend=args.backend, verbosity=verbosity)

        start = time.perf_counter()
        export_requested = args.output is not None
        vi_result = solve_model(mdp, args.gamma, args.epsilon, verbosity=verbosity,  track_history=export_requested, compute_q=export_requested)
        end = time.perf_counter()
        uptime = end - start

        print_solution(vi_result, uptime)

        if export_requested:
            exporter = CSVExporter(mdp, output_dir=args.output)
            exporter.export_all(vi_result)
            if verbosity.level != VerbosityLevel.SILENT:
                print(f">> Results exported successfully to '{args.output}/'")

        if args.command == 'simulate':
            simulator = Simulator(mdp, vi_result.policy)
            states  = StateSpace(mdp.state_schema)
            print()
            for i, state_val in enumerate(states):
                start_state = tuple(state_val.items())    
                avg, _, _ = simulator.run(args.trials, args.horizon, start_state, args.gamma)
                label = ', '.join(f"{f}={v}" for f, v in state_val.items())
                print("Expectation({state}) = {value:.3f}".format(state=label, value=avg))
